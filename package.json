{
  "name": "bilingual-lite",
  "private": true,
  "version": "0.3.3",
  "license": "GPL-3.0-only",
  "author": "Bilingual Lite contributors",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "prebuild": "node scripts/prepare-release-assets.mjs",
    "build": "npm run check && wxt build --mv3 && wxt build -b firefox --mv3",
    "zip": "wxt zip --mv3 && wxt zip -b firefox --mv3",
    "prezip": "node scripts/prepare-release-assets.mjs",
    "audit:licenses": "node scripts/audit-licenses.mjs",
    "lint:firefox": "web-ext lint --source-dir dist/firefox-mv3 --warnings-as-errors",
    "check": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2",
    "web-ext": "10.7.0",
    "wxt": "0.21.4"
  }
}
