{
  "name": "bilingual-lite",
  "private": true,
  "version": "0.2.4",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "npm run check && wxt build --mv3 && wxt build -b firefox --mv3",
    "zip": "wxt zip --mv3 && wxt zip -b firefox --mv3",
    "check": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2",
    "wxt": "0.21.4"
  }
}
